{
  "nodes": [
    {
      "id": "electric-current-definition",
      "label": "電流定義",
      "kind": "definition",
      "summary": "電流是單位時間內通過某區域的電荷量。",
      "latex": "",
      "pages": [
        2
      ]
    },
    {
      "id": "ampere-unit",
      "label": "安培",
      "kind": "definition",
      "summary": "電流的SI單位，定義為每秒一庫侖的電荷流量。",
      "latex": "",
      "pages": [
        2
      ]
    },
    {
      "id": "average-current-formula",
      "label": "平均電流公式",
      "kind": "formula",
      "summary": "平均電流等於電荷變化量除以時間變化量。",
      "latex": "I_{av} = \\frac{\\Delta Q}{\\Delta t}",
      "pages": [
        2
      ]
    },
    {
      "id": "instantaneous-current-formula",
      "label": "瞬時電流公式",
      "kind": "formula",
      "summary": "瞬時電流是電荷對時間的微分。",
      "latex": "I = \\frac{dQ}{dt}",
      "pages": [
        2
      ]
    },
    {
      "id": "conventional-current-direction",
      "label": "傳統電流方向",
      "kind": "concept",
      "summary": "傳統上，電流方向定義為正電荷的流動方向，與電子流動方向相反。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "charge-carrier",
      "label": "載流子",
      "kind": "definition",
      "summary": "任何移動中的電荷，例如金屬中的自由電子或電解質中的離子。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "drude-model",
      "label": "德魯德模型",
      "kind": "concept",
      "summary": "一種經典的電傳導模型，將金屬中的傳導電子視為自由電子氣。",
      "latex": "",
      "pages": [
        6
      ]
    },
    {
      "id": "conduction-electron",
      "label": "傳導電子",
      "kind": "concept",
      "summary": "金屬中可自由移動並參與導電的電子。",
      "latex": "",
      "pages": [
        6
      ]
    },
    {
      "id": "drift-velocity",
      "label": "漂移速度",
      "kind": "definition",
      "summary": "電荷載子在電場作用下，除了隨機熱運動外，所產生的平均淨移動速度。",
      "latex": "",
      "pages": [
        7
      ]
    },
    {
      "id": "drift-velocity-formula",
      "label": "漂移速度公式",
      "kind": "formula",
      "summary": "漂移速度與電場、電荷、平均自由時間成正比，與質量成反比。",
      "latex": "\\vec{v}_d = \\frac{q\\vec{E}}{m}\\tau",
      "pages": [
        8
      ]
    },
    {
      "id": "mean-free-time",
      "label": "平均自由時間",
      "kind": "definition",
      "summary": "電荷載子在兩次碰撞之間平均移動的時間。",
      "latex": "",
      "pages": [
        8
      ]
    },
    {
      "id": "mean-free-path",
      "label": "平均自由徑",
      "kind": "definition",
      "summary": "電荷載子在兩次碰撞之間平均移動的距離。",
      "latex": "",
      "pages": [
        8
      ]
    },
    {
      "id": "electric-field-propagation",
      "label": "電場傳播速度",
      "kind": "concept",
      "summary": "電場以接近光速傳播，使電路中的電子幾乎同時響應，而非等待漂移速度緩慢的電子移動。",
      "latex": "",
      "pages": [
        9
      ]
    },
    {
      "id": "microscopic-current-formula",
      "label": "微觀電流公式",
      "kind": "formula",
      "summary": "電流等於載流子密度、電荷、漂移速度和截面積的乘積。",
      "latex": "I = n q v_d A",
      "pages": [
        10
      ]
    },
    {
      "id": "current-density-definition",
      "label": "電流密度定義",
      "kind": "definition",
      "summary": "電流密度是單位截面積的電流，是一個向量，方向與電流方向相同。",
      "latex": "",
      "pages": [
        10
      ]
    },
    {
      "id": "current-density-formula",
      "label": "電流密度公式",
      "kind": "formula",
      "summary": "電流密度等於載流子密度、電荷和漂移速度的乘積。",
      "latex": "\\vec{J} = n q \\vec{v}_d",
      "pages": [
        10
      ]
    },
    {
      "id": "charge-density",
      "label": "電荷密度",
      "kind": "definition",
      "summary": "單位體積內的電荷量。",
      "latex": "",
      "pages": [
        10
      ]
    },
    {
      "id": "ohms-law-microscopic",
      "label": "歐姆定律(微觀)",
      "kind": "law",
      "summary": "對於許多材料，電流密度與電場的比值是一個常數，稱為電導率。",
      "latex": "\\mathbf{J} = \\sigma \\mathbf{E}",
      "pages": [
        11
      ]
    },
    {
      "id": "conductivity-definition",
      "label": "電導率定義",
      "kind": "definition",
      "summary": "材料傳導電流能力的量度，是電阻率的倒數。",
      "latex": "",
      "pages": [
        11
      ]
    },
    {
      "id": "ohmic-material",
      "label": "歐姆材料",
      "kind": "concept",
      "summary": "遵守歐姆定律的材料，其電導率獨立於電場。",
      "latex": "",
      "pages": [
        11
      ]
    },
    {
      "id": "conductivity-formula",
      "label": "電導率公式",
      "kind": "formula",
      "summary": "電導率與載流子密度、電荷平方、平均自由時間成正比，與電子質量成反比。",
      "latex": "\\sigma = \\frac{nq^2\\tau}{m_e}",
      "pages": [
        12
      ]
    },
    {
      "id": "resistivity-definition",
      "label": "電阻率定義",
      "kind": "definition",
      "summary": "材料抵抗電流流動能力的量度，是電導率的倒數。",
      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "resistivity-formula",
      "label": "電阻率公式",
      "kind": "formula",
      "summary": "電阻率與電子質量成正比，與載流子密度、電荷平方、平均自由時間成反比。",
      "latex": "\\rho = \\frac{m_e}{nq^2\\tau}",
      "pages": [
        12
      ]
    },
    {
      "id": "ohms-law-macroscopic",
      "label": "歐姆定律(宏觀)",
      "kind": "law",
      "summary": "導體兩端的電位差與流經導體的電流成正比，比例常數為電阻。",
      "latex": "\\Delta V = IR",
      "pages": [
        13
      ]
    },
    {
      "id": "resistance-definition",
      "label": "電阻定義",
      "kind": "definition",
      "summary": "導體對電流流動的阻礙程度，定義為電位差與電流的比值。",
      "latex": "",
      "pages": [
        13
      ]
    },
    {
      "id": "resistance-formula",
      "label": "電阻公式",
      "kind": "formula",
      "summary": "電阻與導體長度、電阻率成正比，與截面積成反比。",
      "latex": "R = \\frac{\\ell}{\\sigma A} = \\rho \\frac{\\ell}{A}",
      "pages": [
        13
      ]
    },
    {
      "id": "resistance-geometry-dependence",
      "label": "電阻幾何依賴性",
      "kind": "concept",
      "summary": "導體的電阻不僅取決於材料，還取決於其幾何形狀和電流流動方向。",
      "latex": "",
      "pages": [
        14
      ]
    },
    {
      "id": "nonohmic-material",
      "label": "非歐姆材料",
      "kind": "concept",
      "summary": "不遵守歐姆定律的材料，其電阻率或電導率會隨電場變化。",
      "latex": "",
      "pages": [
        14
      ]
    },
    {
      "id": "cylindrical-resistance-formula",
      "label": "圓柱體電阻公式",
      "kind": "formula",
      "summary": "徑向電流通過同心圓柱體導體的電阻公式。",
      "latex": "R = \\frac{\\rho}{2\\pi L} \\ln\\left(\\frac{b}{a}\\right)",
      "pages": [
        15,
        16
      ]
    },
    {
      "id": "resistivity-temperature-dependence",
      "label": "電阻率溫度依賴性",
      "kind": "formula",
      "summary": "導體的電阻率在一定溫度範圍內與溫度呈近似線性關係。",
      "latex": "\\rho = \\rho_0 [1 + \\alpha(T - T_0)]",
      "pages": [
        16
      ]
    },
    {
      "id": "temperature-coefficient-resistivity",
      "label": "電阻率溫度係數",
      "kind": "definition",
      "summary": "描述材料電阻率隨溫度變化的程度的物理量。",
      "latex": "",
      "pages": [
        16
      ]
    },
    {
      "id": "residual-resistivity",
      "label": "殘餘電阻率",
      "kind": "concept",
      "summary": "金屬在極低溫度下仍存在的電阻率，主要由雜質和晶格缺陷引起。",
      "latex": "",
      "pages": [
        17
      ]
    },
    {
      "id": "semiconductor-resistivity-temp",
      "label": "半導體電阻率與溫度",
      "kind": "concept",
      "summary": "半導體的電阻率隨溫度升高而降低，因為載流子密度增加。",
      "latex": "",
      "pages": [
        17
      ]
    },
    {
      "id": "superconductor-definition",
      "label": "超導體定義",
      "kind": "definition",
      "summary": "一類材料，其電阻在低於某個臨界溫度時會驟降至零。",
      "latex": "",
      "pages": [
        19
      ]
    },
    {
      "id": "critical-temperature",
      "label": "臨界溫度",
      "kind": "definition",
      "summary": "超導材料電阻降至零的特定溫度。",
      "latex": "",
      "pages": [
        19
      ]
    },
    {
      "id": "superconductor-zero-resistance",
      "label": "超導體零電阻",
      "kind": "concept",
      "summary": "一旦電流在超導體中建立，它將在沒有任何施加電壓的情況下持續存在，因為電阻為零。",
      "latex": "",
      "pages": [
        20
      ]
    },
    {
      "id": "electrical-power-definition",
      "label": "電功率定義",
      "kind": "definition",
      "summary": "電路中能量轉換的速率，等於電流與電位差的乘積。",
      "latex": "",
      "pages": [
        23
      ]
    },
    {
      "id": "electrical-power-formula",
      "label": "電功率公式",
      "kind": "formula",
      "summary": "電功率可表示為電流乘以電位差，或電流平方乘以電阻，或電位差平方除以電阻。",
      "latex": "P = I\\Delta V = I^2 R = \\frac{(\\Delta V)^2}{R}",
      "pages": [
        23
      ]
    },
    {
      "id": "power-transmission-loss",
      "label": "電力傳輸損耗",
      "kind": "concept",
      "summary": "電力傳輸中，為減少電阻造成的功率損耗，通常採用高電壓、低電流的方式。",
      "latex": "",
      "pages": [
        23
      ]
    },
    {
      "id": "electromotive-force-definition",
      "label": "電動勢定義",
      "kind": "definition",
      "summary": "驅動電荷移動的電位差，是能量源而非力，通常由電池等提供。",
      "latex": "",
      "pages": [
        27
      ]
    },
    {
      "id": "charge-pump-analogy",
      "label": "電荷泵浦類比",
      "kind": "concept",
      "summary": "電動勢源可被視為將電荷從低電位「泵浦」到高電位的裝置。",
      "latex": "",
      "pages": [
        27
      ]
    },
    {
      "id": "circuit-water-analogy",
      "label": "電路水路類比",
      "kind": "concept",
      "summary": "將電路中的電壓類比為水壓，電流類比為水流，電阻類比為水輪，有助於理解電路原理。",
      "latex": "",
      "pages": [
        28
      ]
    },
    {
      "id": "internal-resistance",
      "label": "內電阻",
      "kind": "definition",
      "summary": "電源（如電池）本身對電流流動的阻礙，導致其端電壓低於電動勢。",
      "latex": "",
      "pages": [
        29
      ]
    },
    {
      "id": "terminal-voltage-formula",
      "label": "端電壓公式",
      "kind": "formula",
      "summary": "電源的端電壓等於電動勢減去電流通過內電阻造成的電壓降。",
      "latex": "\\Delta V = \\mathcal{E} - Ir",
      "pages": [
        30
      ]
    },
    {
      "id": "current-with-internal-resistance",
      "label": "含內阻電路電流",
      "kind": "formula",
      "summary": "含有內電阻的電路中，電流等於電動勢除以總電阻（外電阻加內電阻）。",
      "latex": "I = \\frac{\\mathcal{E}}{R+r}",
      "pages": [
        30
      ]
    },
    {
      "id": "energy-conservation-circuit",
      "label": "電路能量守恆",
      "kind": "principle",
      "summary": "電源提供的總功率等於外部負載消耗的功率與內部電阻消耗的功率之和。",
      "latex": "I\\mathcal{E} = I^2R + I^2r",
      "pages": [
        30
      ]
    },
    {
      "id": "maximum-power-transfer-theorem",
      "label": "最大功率傳輸定理",
      "kind": "principle",
      "summary": "當負載電阻等於電源的內電阻時，傳輸到負載的功率最大。",
      "latex": "",
      "pages": [
        31
      ]
    }
  ],
