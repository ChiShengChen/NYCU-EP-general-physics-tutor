      "pages": [
        30
      ]
    },
    {
      "id": "total-linear-momentum-cm",
      "label": "總線動量(質心)",
      "kind": "formula",
      "summary": "系統的總線動量等於總質量乘以質心速度。",
      "latex": "P_{total} = M v_{CM}",
      "pages": [
        36
      ]
    },
    {
      "id": "net-external-force-cm",
      "label": "系統淨外力(質心)",
      "kind": "formula",
      "summary": "作用在系統上的淨外力等於系統總質量乘以質心加速度。",
      "latex": "F_{total} = M a_{CM}",
      "pages": [
        36
      ]
    },
    {
      "id": "total-kinetic-energy-system",
      "label": "系統總動能",
      "kind": "formula",
      "summary": "系統總動能等於質心動能加上相對於質心的動能。",
      "latex": "K = \\frac{1}{2} M v_{CM}^2 + \\sum_i \\frac{1}{2} m_i u_i^2",
      "pages": [
        39
      ]
    },
    {
      "id": "gravitational-potential-energy-system",
      "label": "系統重力位能",
      "kind": "formula",
      "summary": "若重力均勻，系統重力位能如同所有質量集中於質心。",
      "latex": "U_g = M g y_{CM}",
      "pages": [
        40
      ]
    },
    {
      "id": "work-kinetic-energy-theorem-cm",
      "label": "質心功動能定理",
      "kind": "formula",
      "summary": "作用在質心上的淨功等於質心動能的變化量。",
      "latex": "W_{CM} = F_{CM} \\cdot \\Delta r_{CM} = \\Delta K_{CM}",
      "pages": [
        40
      ]
    },
    {
      "id": "work-external-forces-system",
      "label": "系統外力做功",
      "kind": "principle",
