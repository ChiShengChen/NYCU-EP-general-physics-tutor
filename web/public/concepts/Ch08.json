    {
      "id": "linear-momentum-definition",
      "label": "線動量定義",
      "kind": "definition",
      "summary": "線動量定義為物體的質量與速度的乘積。",
      "latex": "P = mv",
      "pages": [
        4
      ]
    },
    {
      "id": "momentum-conservation",
      "label": "動量守恆",
      "kind": "principle",
      "summary": "孤立系統的總線動量保持不變。",
      "latex": "",
      "pages": [
        3,
        4
      ]
    },
    {
      "id": "newtons-second-law-momentum-form",
      "label": "牛頓第二定律(動量)",
      "kind": "law",
      "summary": "線動量的時間變化率等於作用在物體上的淨力。",
      "latex": "F = dP/dt",
      "pages": [
        4
      ]
    },
    {
      "id": "impulse-definition",
      "label": "衝量定義",
      "kind": "definition",
      "summary": "作用在粒子上的力在一段時間內的積分，等於粒子動量的變化。",
      "latex": "",
      "pages": [
        5
      ]
    },
    {
      "id": "impulse-momentum-theorem",
      "label": "衝量動量定理",
      "kind": "formula",
      "summary": "作用在物體上的衝量等於物體動量的變化量。",
      "latex": "I = \\Delta P = \\int_{t_i}^{t_f} F dt",
      "pages": [
        5
      ]
    },
    {
      "id": "collision-concept",
      "label": "碰撞",
      "kind": "concept",
      "summary": "物體間在相對短時間內發生的強烈交互作用。",
      "latex": "",
      "pages": [
        11
      ]
    },
    {
      "id": "elastic-collision-definition",
      "label": "彈性碰撞",
      "kind": "definition",
      "summary": "碰撞前後系統的總動能守恆的碰撞。",
      "latex": "",
      "pages": [
        11
      ]
    },
    {
      "id": "inelastic-collision-definition",
      "label": "非彈性碰撞",
      "kind": "definition",
      "summary": "碰撞前後系統的總動能不守恆的碰撞。",
      "latex": "",
      "pages": [
        11
      ]
    },
    {
      "id": "1d-head-on-elastic-collision-formulas",
      "label": "一維彈性碰撞公式",
      "kind": "formula",
      "summary": "描述一維彈性碰撞中動量與動能守恆的方程式組。",
      "latex": "m_1 v_{1i} + m_2 v_{2i} = m_1 v_{1f} + m_2 v_{2f} \\\\ \\frac{1}{2} m_1 v_{1i}^2 + \\frac{1}{2} m_2 v_{2i}^2 = \\frac{1}{2} m_1 v_{1f}^2 + \\frac{1}{2} m_2 v_{2f}^2",
      "pages": [
        12
      ]
    },
    {
      "id": "relative-velocity-elastic-collision",
      "label": "彈性碰撞相對速度",
      "kind": "formula",
      "summary": "彈性碰撞中，碰撞前後相對速度大小相等方向相反。",
      "latex": "v_{1i} - v_{2i} = -(v_{1f} - v_{2f})",
      "pages": [
        12
      ]
    },
    {
      "id": "center-of-mass-velocity",
      "label": "質心速度",
      "kind": "formula",
      "summary": "系統總動量除以總質量，描述質心的運動速度。",
      "latex": "v_{CM} = \\frac{m_1 v_{1i} + m_2 v_{2i}}{m_1 + m_2}",
      "pages": [
        13,
        36
      ]
    },
    {
      "id": "identical-particles-elastic-collision",
      "label": "相同粒子彈性碰撞",
      "kind": "principle",
      "summary": "相同質量粒子彈性碰撞後，會交換彼此的速度。",
      "latex": "",
      "pages": [
        14
      ]
    },
    {
      "id": "elastic-collision-stationary-target-formulas",
      "label": "靜止靶彈性碰撞",
      "kind": "formula",
      "summary": "描述物體與靜止靶進行一維彈性碰撞後的速度、動量及動能轉換公式。",
      "latex": "v_{1f} = \\left(\\frac{m_1 - m_2}{m_1 + m_2}\\right) v_{1i} \\\\ v_{2f} = \\left(\\frac{2m_1}{m_1 + m_2}\\right) v_{1i}",
      "pages": [
        15
      ]
    },
    {
      "id": "kinetic-energy-transfer-elastic-collision",
      "label": "彈性碰撞動能轉換",
      "kind": "formula",
      "summary": "描述一維彈性碰撞中，動能如何在碰撞物體間轉移的比例關係。",
      "latex": "\\frac{K_{1f}}{K_{1i}} = \\left(\\frac{m_1 - m_2}{m_1 + m_2}\\right)^2 \\\\ \\frac{K_{2f}}{K_{1i}} = \\frac{4m_1 m_2}{(m_1 + m_2)^2}",
      "pages": [
        15
      ]
    },
    {
      "id": "perfectly-inelastic-collision-definition",
      "label": "完全非彈性碰撞",
      "kind": "definition",
      "summary": "碰撞後物體黏在一起，以共同速度運動，且動能損失最大的碰撞。",
      "latex": "",
      "pages": [
        18,
        19
      ]
    },
    {
      "id": "final-velocity-perfectly-inelastic-collision",
      "label": "完全非彈性碰撞末速",
      "kind": "formula",
      "summary": "碰撞後物體黏在一起，其共同末速度由總動量守恆決定。",
      "latex": "v_f = \\frac{m_1 v_{1i} + m_2 v_{2i}}{m_1 + m_2}",
      "pages": [
        19
      ]
    },
    {
      "id": "coefficient-of-restitution",
      "label": "恢復係數",
      "kind": "definition",
      "summary": "碰撞後相對速度與碰撞前相對速度大小之比值，用於量化碰撞的彈性程度。",
      "latex": "e = \\frac{|v_{1f} - v_{2f}|}{|v_{1i} - v_{2i}|}",
      "pages": [
        20
      ]
    },
    {
      "id": "ballistic-pendulum-method",
      "label": "彈道擺法",
      "kind": "method",
      "summary": "利用非彈性碰撞和能量守恆原理，測量子彈初速度的方法。",
      "latex": "",
      "pages": [
        22
      ]
    },
    {
      "id": "2d-elastic-glancing-collision",
      "label": "二維彈性擦撞",
      "kind": "concept",
      "summary": "描述物體在二維平面上發生彈性碰撞，且非正向撞擊的情況。",
      "latex": "",
      "pages": [
        27
      ]
    },
    {
      "id": "2d-elastic-glancing-collision-formulas",
      "label": "二維彈性擦撞公式",
      "kind": "formula",
      "summary": "描述二維彈性擦撞中動量與動能守恆的方程式組。",
      "latex": "m_1 v_{1i} = m_1 v_{1f} \\cos \\theta + m_2 v_{2f} \\cos \\phi \\\\ 0 = m_1 v_{1f} \\sin \\theta - m_2 v_{2f} \\sin \\phi \\\\ \\frac{1}{2} m_1 v_{1i}^2 = \\frac{1}{2} m_1 v_{1f}^2 + \\frac{1}{2} m_2 v_{2f}^2",
      "pages": [
        27
      ]
    },
    {
      "id": "impact-parameter",
      "label": "撞擊參數",
      "kind": "concept",
      "summary": "碰撞前入射物體速度向量與靶心連線的垂直距離。",
      "latex": "",
      "pages": [
        27
      ]
    },
    {
      "id": "scattering-angle-2d-elastic-collision",
      "label": "二維彈性碰撞散射角",
      "kind": "principle",
      "summary": "二維彈性碰撞後兩物體散射角度與其質量比的關係。",
      "latex": "",
      "pages": [
        28
      ]
    },
    {
      "id": "center-of-mass-concept",
      "label": "質心",
      "kind": "concept",
      "summary": "系統質量加權平均位置，系統運動如同所有外力作用於此點。",
      "latex": "",
      "pages": [
        29
      ]
    },
    {
      "id": "cm-discrete-objects-formula",
      "label": "離散質點質心",
      "kind": "formula",
      "summary": "計算由多個離散質點組成的系統的質心位置。",
      "latex": "\\vec{r}_{CM} = \\frac{\\sum_i m_i \\vec{r}_i}{M}",
      "pages": [
        30
      ]
    },
    {
      "id": "cm-continuous-objects-formula",
      "label": "連續物體質心",
      "kind": "formula",
      "summary": "計算連續質量分佈物體的質心位置。",
      "latex": "\\vec{r}_{CM} = \\frac{\\int \\vec{r} dm}{M}",
      "pages": [
        30
      ]
    },
    {
      "id": "center-of-gravity",
      "label": "重心",
      "kind": "concept",
      "summary": "系統所有重力作用的等效點，若重力均勻則與質心重合。",
