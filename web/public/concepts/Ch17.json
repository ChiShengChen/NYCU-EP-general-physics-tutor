  "nodes": [
    {
      "id": "thermal-contact",
      "label": "熱接觸",
      "kind": "definition",
      "summary": "兩個物體之間若能交換能量，則稱它們處於熱接觸。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "thermal-equilibrium",
      "label": "熱平衡",
      "kind": "definition",
      "summary": "兩個物體若處於熱接觸時沒有淨能量交換，則稱它們處於熱平衡。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "zeroth-law-thermodynamics",
      "label": "熱力學第零定律",
      "kind": "law",
      "summary": "若A和B分別與C熱平衡，則A和B彼此熱平衡；兩系統熱平衡若且唯若它們溫度相同。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "temperature",
      "label": "溫度",
      "kind": "concept",
      "summary": "溫度是決定物體是否與其他物體熱平衡的性質。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "thermometer",
      "label": "溫度計",
      "kind": "definition",
      "summary": "溫度計是測量系統溫度的裝置，基於物理性質隨溫度變化而改變的原理。",
      "latex": "",
      "pages": [
        6
      ]
    },
    {
      "id": "celsius-temperature-scale",
      "label": "攝氏溫標",
      "kind": "definition",
      "summary": "以水冰點為0°C、沸點為100°C定義的溫標。",
      "latex": "",
      "pages": [
        7
      ]
    },
    {
      "id": "fahrenheit-temperature-scale",
      "label": "華氏溫標",
      "kind": "definition",
      "summary": "以水冰點為32°F、沸點為212°F定義的溫標。",
      "latex": "",
      "pages": [
        7
      ]
    },
    {
      "id": "fahrenheit-celsius-conversion",
      "label": "華氏攝氏轉換",
      "kind": "formula",
      "summary": "華氏溫度與攝氏溫度的轉換公式。",
      "latex": "T_F = \\frac{9}{5}T_C + 32^\\circ \\text{F}",
      "pages": [
        7
      ]
    },
    {
      "id": "absolute-zero",
      "label": "絕對零度",
      "kind": "concept",
      "summary": "理論上物質所能達到的最低溫度，約為-273.15°C。",
      "latex": "",
      "pages": [
        8
      ]
    },
    {
      "id": "kelvin-temperature-scale",
      "label": "克耳文溫標",
      "kind": "definition",
      "summary": "以絕對零度為0 K定義的溫標，單位為克耳文。",
      "latex": "",
      "pages": [
        8
      ]
    },
    {
      "id": "celsius-kelvin-conversion",
      "label": "攝氏克耳文轉換",
      "kind": "formula",
      "summary": "攝氏溫度與克耳文溫度的轉換公式。",
      "latex": "T_{\\text{Celsius}} = T - 273.15",
      "pages": [
        8
      ]
    },
    {
      "id": "thermal-expansion",
      "label": "熱膨脹",
      "kind": "concept",
      "summary": "物體因溫度升高而尺寸增大的現象，是原子平均間距變化的結果。",
      "latex": "",
      "pages": [
        10
      ]
    },
    {
      "id": "linear-expansion",
      "label": "線膨脹",
      "kind": "formula",
      "summary": "物體長度隨溫度變化而改變的現象，其變化量由線膨脹係數 $\\alpha$ 決定。",
      "latex": "\\Delta L = \\alpha L_i \\Delta T",
      "pages": [
        11
      ]
    },
    {
      "id": "unusual-water-expansion",
      "label": "水的異常膨脹",
      "kind": "concept",
      "summary": "水在4°C時密度最大，從4°C降至0°C時體積反而膨脹。",
      "latex": "",
      "pages": [
        13
      ]
    },
    {
      "id": "youngs-modulus",
      "label": "楊氏模數",
      "kind": "definition",
      "summary": "材料的應力與應變之比，衡量材料抵抗彈性變形的能力。",
      "latex": "",
      "pages": [
        14
      ]
    },
    {
      "id": "thermal-stress-formula",
      "label": "熱應力公式",
      "kind": "formula",
      "summary": "計算物體因溫度變化且被限制形變時產生的應力。",
      "latex": "\\frac{F}{A} = -(\\alpha \\Delta T) Y",
      "pages": [
        14
      ]
    },
    {
      "id": "volume-expansion",
      "label": "體膨脹",
      "kind": "formula",
      "summary": "物體體積隨溫度變化而改變的現象，其變化量由體膨脹係數 $\\beta$ 決定。",
      "latex": "\\Delta V = \\beta V_i \\Delta T",
      "pages": [
        15
      ]
    },
    {
      "id": "relation-between-alpha-and-beta",
      "label": "線體膨脹係數關係",
      "kind": "formula",
      "summary": "對於各向同性固體，體膨脹係數約為線膨脹係數的三倍。",
      "latex": "\\beta = 3\\alpha",
      "pages": [
        15
      ]
    },
    {
      "id": "heat",
      "label": "熱",
      "kind": "definition",
      "summary": "熱是因系統與環境間的溫差而跨越系統邊界傳遞的能量。",
      "latex": "",
      "pages": [
        17
      ]
    },
    {
      "id": "mechanical-equivalent-heat",
      "label": "熱功當量",
      "kind": "concept",
      "summary": "機械能與內能之間的等效關係，由焦耳實驗確立。",
      "latex": "",
      "pages": [
        18
      ]
    },
    {
      "id": "joule-calorie-conversion",
      "label": "焦耳卡路里轉換",
      "kind": "formula",
      "summary": "焦耳與卡路里之間的轉換關係。",
      "latex": "1 \\text{ cal} = 4.186 \\text{ J}",
      "pages": [
        18
      ]
    },
    {
      "id": "heat-capacity",
      "label": "熱容量",
      "kind": "definition",
      "summary": "使特定樣品溫度升高1°C所需的能量。",
      "latex": "",
      "pages": [
        19
      ]
    },
    {
      "id": "specific-heat",
      "label": "比熱",
      "kind": "formula",
      "summary": "單位質量物質升高單位溫度所需的能量，其計算公式為 $Q = mc\\Delta T$。",
      "latex": "c \\equiv \\frac{Q}{m\\Delta T}",
      "pages": [
        19
      ]
    },
    {
      "id": "calorimetry",
      "label": "量熱法",
      "kind": "method",
      "summary": "利用能量守恆原理，在絕熱系統中分析熱量交換以確定最終溫度或物質性質。",
      "latex": "m_w c_w (T_f - T_w) = -m_x c_x (T_f - T_x)",
      "pages": [
        21
      ]
    },
    {
      "id": "phase-change",
      "label": "相變",
      "kind": "concept",
      "summary": "物質從一種物理狀態轉變為另一種物理狀態的過程，例如固態變液態。",
      "latex": "",
      "pages": [
        22
      ]
    },
