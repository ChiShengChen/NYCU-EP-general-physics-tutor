      "latex": "d\\vec{B} = \\frac{\\mu_0}{4\\pi} \\frac{Id\\vec{s} \\times \\hat{r}}{r^2}",
      "pages": [
        3
      ]
    },
    {
      "id": "permeability-free-space",
