      "latex": "",
      "pages": [
        11,
        12
      ]
    },
    {
      "id": "complex-inductive-reactance",
      "label": "複數感抗",
      "kind": "formula",
      "summary": "電感在交流電路中的複數阻抗表示。",
      "latex": "\\tilde{X}_L(\\omega) = i\\omega L",
      "pages": [
        11
      ]
    },
    {
      "id": "complex-capacitive-reactance",
      "label": "複數容抗",
      "kind": "formula",
      "summary": "電容在交流電路中的複數阻抗表示。",
      "latex": "\\tilde{X}_C(\\omega) = \\frac{1}{i\\omega C}",
      "pages": [
        12
      ]
    },
    {
      "id": "rlc-series-circuit-voltage-sum",
      "label": "串聯RLC電路總電壓",
      "kind": "formula",
      "summary": "串聯RLC電路中的總電壓是各元件瞬時電壓的向量和。",
      "latex": "\\Delta v(t) = \\Delta v_R(t) + \\Delta v_L(t) + \\Delta v_C(t)",
      "pages": [
        13
      ]
    },
    {
      "id": "rlc-series-circuit-peak-voltage",
      "label": "串聯RLC峰值電壓",
      "kind": "formula",
      "summary": "串聯RLC電路中的峰值電壓，由電阻電壓和淨電抗電壓的平方和開根號得到。",
      "latex": "\\Delta V_0 = \\sqrt{\\Delta V_R^2 + (\\Delta V_L - \\Delta V_C)^2}",
      "pages": [
        16
      ]
    },
    {
      "id": "impedance-definition",
      "label": "阻抗定義",
      "kind": "definition",
      "summary": "交流電路中對電流的總阻礙，包含電阻和電抗的影響，單位為歐姆。",
      "latex": "Z = \\sqrt{R^2 + (X_L - X_C)^2}",
      "pages": [
        16
      ]
    },
    {
      "id": "ohm-law-ac-impedance",
      "label": "交流歐姆定律(阻抗)",
      "kind": "formula",
      "summary": "交流電路中峰值電壓、峰值電流和阻抗之間的關係。",
      "latex": "\\Delta V_0 = I_0 Z",
      "pages": [
        16
      ]
    },
    {
      "id": "impedance-triangle",
      "label": "阻抗三角形",
      "kind": "concept",
      "summary": "用於視覺化電阻、電抗和阻抗之間關係的直角三角形。",
      "latex": "",
      "pages": [
        17
      ]
    },
    {
      "id": "phase-angle-rlc",
      "label": "RLC電路相位角",
      "kind": "formula",
      "summary": "串聯RLC電路中總電壓與電流之間的相位角。",
      "latex": "\\varphi = \\tan^{-1}\\left(\\frac{X_L - X_C}{R}\\right)",
      "pages": [
        17
      ]
    },
    {
      "id": "inductive-capacitive-circuit-types",
      "label": "電路電抗分類",
