      "latex": "i(t) = \\frac{\\Delta V_{\\text{max}}}{\\sqrt{R^2 + \\left(\\omega L - \\frac{1}{\\omega C}\\right)^2}} \\sin(\\omega t - \\phi)",
      "pages": [
        18
      ]
    },
    {
      "id": "rms-value-definition",
