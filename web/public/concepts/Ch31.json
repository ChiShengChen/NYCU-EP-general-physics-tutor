{
  "nodes": [
    {
      "id": "ac-source-definition",
      "label": "交流電源定義",
      "kind": "definition",
      "summary": "交流電源提供隨時間正弦變化的電壓。",
      "latex": "\\Delta v (t) = V_0 \\sin \\omega t",
      "pages": [
        2
      ]
    },
    {
      "id": "angular-frequency-ac",
      "label": "交流角頻率",
      "kind": "formula",
      "summary": "交流電壓的角頻率，與頻率和週期相關。",
      "latex": "\\omega = 2\\pi f = \\frac{2\\pi}{T}",
      "pages": [
        2
      ]
    },
    {
      "id": "voltage-resistor-ac",
      "label": "電阻交流電壓",
      "kind": "formula",
      "summary": "交流電路中電阻兩端的電壓等於電流乘以電阻。",
      "latex": "\\Delta v(t) = I(t)R",
      "pages": [
        3
      ]
    },
    {
      "id": "voltage-capacitor-ac",
      "label": "電容交流電壓",
      "kind": "formula",
      "summary": "交流電路中電容兩端的電壓等於電荷量除以電容值。",
      "latex": "\\Delta v(t) = \\frac{Q(t)}{C}",
      "pages": [
        3
      ]
    },
    {
      "id": "voltage-inductor-ac",
      "label": "電感交流電壓",
      "kind": "formula",
      "summary": "交流電路中電感兩端的電壓等於電感值乘以電流的變化率。",
      "latex": "\\Delta v(t) = L \\frac{dI(t)}{dt}",
      "pages": [
        3
      ]
    },
    {
      "id": "current-resistor-ac",
      "label": "電阻交流電流",
      "kind": "formula",
      "summary": "交流電路中電阻的電流與電壓同相，峰值電流由峰值電壓除以電阻得到。",
      "latex": "i_R(t) = \\left(\\frac{V_0}{R}\\right) \\sin \\omega t = I_0 \\sin \\omega t",
      "pages": [
        4
      ]
    },
    {
      "id": "peak-current-resistor",
      "label": "電阻峰值電流",
      "kind": "formula",
      "summary": "交流電路中電阻的峰值電流，等於峰值電壓除以電阻。",
      "latex": "I_0 = \\frac{V_0}{R}",
      "pages": [
        4
      ]
    },
    {
      "id": "resistor-voltage-current-phase",
      "label": "電阻電壓電流同相",
      "kind": "principle",
      "summary": "在交流電路中，電阻兩端的電壓與流經電阻的電流同相。",
