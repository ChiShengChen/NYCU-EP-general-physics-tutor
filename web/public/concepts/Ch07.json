      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "conservation-of-energy-principle",
      "label": "能量守恆定律",
      "kind": "law",
      "summary": "能量既不能被創造也不能被消滅，只能從一種形式轉換為另一種形式。",
      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "energy-conservation-isolated-system-formula",
      "label": "孤立系統能量守恆",
      "kind": "formula",
      "summary": "孤立系統的總能量變化為零。",
      "latex": "\\Delta E_{\\text{system}} = 0",
      "pages": [
        12
      ]
    },
    {
      "id": "energy-conservation-non-isolated-system-formula",
      "label": "非孤立系統能量守恆",
      "kind": "formula",
      "summary": "非孤立系統的總能量變化等於跨越系統邊界的能量轉移總和。",
      "latex": "\\Delta K + \\Delta U + \\Delta E_{\\text{int}} = W_{\\text{ext}} + Q + T_{\\text{others}}",
      "pages": [
        12
      ]
    },
    {
      "id": "work-kinetic-energy-theorem",
      "label": "功動能定理",
      "kind": "law",
      "summary": "作用在系統上的淨功等於系統動能的變化量。",
      "latex": "W_{\\text{ext}} = K_f - K_i = \\Delta K",
      "pages": [
        13
      ]
    },
    {
      "id": "conservation-of-mechanical-energy-principle",
      "label": "力學能守恆原理",
      "kind": "principle",
      "summary": "在沒有非保守力作用的孤立系統中，力學能守恆。",
      "latex": "\\Delta E_{mech} = 0",
      "pages": [
        14
      ]
    },
    {
      "id": "general-work-energy-theorem",
      "label": "廣義功能量定理",
      "kind": "formula",
      "summary": "外部功等於動能、位能和內能的總變化量，適用於包含保守力與非保守力的系統。",
      "latex": "W_{ext} = \\Delta K + \\Delta U_g + \\Delta E_{int}",
      "pages": [
        15
      ]
    },
    {
      "id": "conservative-force-properties",
      "label": "守恆力特性",
      "kind": "definition",
      "summary": "功與路徑無關、封閉路徑功為零、可逆、可表示為位能差的力。",
      "latex": "",
      "pages": [
        27
      ]
    },
    {
      "id": "work-gravitational-force-formula",
      "label": "重力做功公式",
      "kind": "formula",
      "summary": "重力所做的功等於重力位能的負變化量。",
      "latex": "W_g = -\\Delta U_g",
      "pages": [
        27
      ]
    },
    {
      "id": "work-spring-force-formula",
      "label": "彈力做功公式",
      "kind": "formula",
      "summary": "彈力所做的功等於彈力位能的負變化量。",
      "latex": "W_s = -\\Delta U_s",
      "pages": [
        27
      ]
    },
    {
      "id": "conservative-force-from-potential-1d",
      "label": "守恆力與位能關係 (1D)",
      "kind": "formula",
      "summary": "一維守恆力是位能函數對位置的負導數。",
      "latex": "F_c = -\\frac{dU(x)}{dx}",
