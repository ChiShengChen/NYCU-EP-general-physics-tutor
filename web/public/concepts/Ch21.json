    {
      "id": "superposition-principle-electric-field",
      "label": "電場疊加原理",
      "kind": "principle",
      "summary": "總電場是各個點電荷產生電場的向量和。",
      "latex": "\\vec{E} = k_e \\sum_i \\frac{Q_i}{r_i^2} \\hat{r}_i",
      "pages": [
        17
      ]
