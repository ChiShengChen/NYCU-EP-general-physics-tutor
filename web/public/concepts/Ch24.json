{
  "nodes": [
    {
      "id": "capacitor",
      "label": "電容器",
      "kind": "concept",
      "summary": "儲存電能與電荷的裝置，由兩個導體與絕緣體組成。",
      "latex": "",
      "pages": [
        2
      ]
    },
    {
      "id": "capacitance-definition",
      "label": "電容定義",
      "kind": "definition",
      "summary": "電容器儲存電荷與電位差的比值，衡量其儲存電荷的能力。",
      "latex": "C \\equiv \\frac{|Q|}{|\\Delta V|}",
      "pages": [
        4
      ]
    },
    {
      "id": "farad",
      "label": "法拉",
      "kind": "concept",
      "summary": "電容的國際單位，定義為每伏特一庫侖。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "parallel-plate-capacitor-capacitance",
      "label": "平行板電容",
      "kind": "formula",
      "summary": "平行板電容器的電容值，與板面積成正比，與板間距成反比。",
      "latex": "C = \\frac{\\epsilon_0 A}{d}",
      "pages": [
        4
      ]
    },
    {
      "id": "fringe-fields",
      "label": "邊緣場",
      "kind": "concept",
      "summary": "電容器邊緣處電場線彎曲向外，不均勻分佈。",
      "latex": "",
      "pages": [
        6
      ]
    },
    {
      "id": "spherical-capacitor-capacitance",
      "label": "球形電容",
      "kind": "formula",
      "summary": "球形電容器的電容值，取決於內外球半徑。",
      "latex": "C = \\frac{ab}{k_e (b-a)}",
      "pages": [
        6
      ]
    },
    {
      "id": "conducting-sphere-capacitance",
      "label": "導體球電容",
      "kind": "formula",
      "summary": "單一導體球的電容值，假設另一極在無限遠處。",
      "latex": "C = 4\\pi\\varepsilon_o a",
      "pages": [
        7
      ]
    },
    {
      "id": "cylindrical-capacitor-capacitance",
      "label": "圓柱形電容",
      "kind": "formula",
      "summary": "圓柱形電容器的電容值，與長度成正比，與半徑比的對數成反比。",
      "latex": "\\frac{C}{\\ell} = \\frac{1}{2k_e \\ln(b/a)}",
      "pages": [
        7
      ]
    },
    {
      "id": "two-spheres-capacitance",
      "label": "雙球電容",
      "kind": "formula",
      "summary": "兩個相距遙遠的導體球系統的電容值。",
      "latex": "C = \\frac{4\\pi\\epsilon_0}{(1/a) + (1/b) - (2/d)}",
      "pages": [
        8
      ]
    },
    {
      "id": "parallel-capacitors",
      "label": "電容並聯",
      "kind": "formula",
      "summary": "電容器並聯時，總電容為各電容之和。",
      "latex": "C_{eq} = C_1 + C_2",
      "pages": [
        9
      ]
    },
    {
      "id": "series-capacitors",
      "label": "電容串聯",
      "kind": "formula",
      "summary": "電容器串聯時，總電容的倒數為各電容倒數之和。",
      "latex": "\\frac{1}{C_{eq}} = \\frac{1}{C_1} + \\frac{1}{C_2}",
      "pages": [
        9
      ]
    },
    {
      "id": "symmetry-method-capacitors",
      "label": "電容對稱法",
      "kind": "method",
      "summary": "利用電路對稱性簡化電容器網路，找出等效電容。",
      "latex": "",
      "pages": [
        11
      ]
    },
    {
      "id": "energy-stored-capacitor",
      "label": "電容儲能",
      "kind": "formula",
      "summary": "電容器中儲存的電能，可表示為電荷、電容或電位差的函數。",
      "latex": "U_E = \\frac{Q^2}{2C} = \\frac{1}{2} Q \\Delta V = \\frac{1}{2} C (\\Delta V)^2",
      "pages": [
        12
      ]
    },
    {
      "id": "energy-density-electric-field",
      "label": "電場能量密度",
      "kind": "formula",
      "summary": "電場中每單位體積儲存的能量，與電場強度的平方成正比。",
      "latex": "u_E = \\frac{1}{2}(\\varepsilon_0 E^2)",
      "pages": [
        13
      ]
    },
    {
      "id": "isolated-capacitor-separation-effect",
      "label": "孤立電容板距效應",
      "kind": "concept",
      "summary": "孤立電容器板距增加時，電容下降，電荷不變，電場不變，電位差與儲能上升。",
      "latex": "",
      "pages": [
        14
      ]
    },
    {
      "id": "connected-capacitor-separation-effect",
      "label": "連接電容板距效應",
      "kind": "concept",
      "summary": "連接電池的電容器板距增加時，電容下降，電荷下降，電場下降，電位差不變，儲能下降。",
      "latex": "",
      "pages": [
        14
      ]
    },
    {
      "id": "dielectric",
      "label": "介電質",
      "kind": "definition",
      "summary": "一種非導電材料，置於電容器板間可增加電容。",
      "latex": "",
      "pages": [
        18
      ]
    },
    {
      "id": "dielectric-constant",
      "label": "介電常數",
      "kind": "concept",
      "summary": "衡量介電質增加電容能力的無單位常數，恆大於等於1。",
      "latex": "\\kappa \\ge 1",
      "pages": [
        18
      ]
    },
    {
      "id": "capacitance-with-dielectric",
      "label": "含介電質電容",
      "kind": "formula",
      "summary": "插入介電質後，電容值會增加介電常數倍。",
      "latex": "C = \\kappa C_0",
      "pages": [
        18
      ]
    },
    {
      "id": "electric-field-with-dielectric",
      "label": "含介電質電場",
      "kind": "formula",
      "summary": "插入介電質後，電場強度會減小介電常數倍。",
      "latex": "E = \\frac{E_0}{\\kappa}",
      "pages": [
        18
      ]
    },
    {
      "id": "dielectric-breakdown",
      "label": "介電崩潰",
      "kind": "concept",
      "summary": "介電質在強電場下失去絕緣性，變成導體的現象。",
      "latex": "",
      "pages": [
        20
      ]
    },
    {
      "id": "dielectric-strength",
      "label": "介電強度",
      "kind": "definition",
      "summary": "材料在發生介電崩潰前所能承受的最大電場強度。",
      "latex": "",
      "pages": [
        20
      ]
    },
    {
      "id": "tubular-capacitor",
      "label": "管狀電容",
      "kind": "concept",
      "summary": "由金屬箔與絕緣紙捲繞而成的電容器。",
      "latex": "",
      "pages": [
        21
      ]
    },
    {
      "id": "oil-filled-capacitor",
      "label": "油浸電容",
      "kind": "concept",
      "summary": "用於高電壓，金屬板浸泡在矽油中的電容器。",
      "latex": "",
      "pages": [
        21
      ]
    },
    {
      "id": "electrolytic-capacitor",
      "label": "電解電容",
      "kind": "concept",
