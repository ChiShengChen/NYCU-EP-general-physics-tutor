    {
      "id": "capacitance-partial-dielectric-slab",
      "label": "含部分介電質電容",
      "kind": "formula",
      "summary": "平行板電容器中插入部分厚度介電質後的電容值。",
      "latex": "C = \\left( \\frac{3\\kappa}{2\\kappa+1} \\right) C_0",
      "pages": [
        31
      ]
