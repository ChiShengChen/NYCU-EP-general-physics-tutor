      "pages": [
        16,
        23,
        25
      ]
    },
    {
      "id": "carnot-cycle",
      "label": "卡諾循環",
      "kind": "concept",
      "summary": "由兩個等溫可逆過程和兩個絕熱可逆過程組成的理想熱力學循環。",
      "latex": "",
      "pages": [
        23,
        29
      ]
    },
    {
      "id": "carnot-theorem",
      "label": "卡諾定理",
      "kind": "law",
      "summary": "所有可逆熱機在相同兩熱源間效率相同，且無熱機效率能超越可逆熱機。",
      "latex": "",
      "pages": [
        25
      ]
    },
    {
      "id": "carnot-engine-efficiency",
      "label": "卡諾熱機效率",
      "kind": "formula",
      "summary": "卡諾熱機的熱效率，僅取決於高低溫熱源的絕對溫度。",
      "latex": "e_C = 1 - \\frac{T_c}{T_h}",
      "pages": [
        29,
        30
      ]
    },
    {
      "id": "carnot-cop-heating",
      "label": "卡諾熱泵性能係數 (加熱)",
      "kind": "formula",
      "summary": "理想卡諾熱泵在加熱模式下的性能係數。",
      "latex": "\\text{COP}_C = \\frac{T_h}{T_h - T_c}",
      "pages": [
        31
      ]
    },
    {
      "id": "carnot-cop-cooling",
      "label": "卡諾冰箱性能係數 (製冷)",
      "kind": "formula",
      "summary": "理想卡諾冰箱在製冷模式下的性能係數。",
      "latex": "\\text{COP}_C = \\frac{T_c}{T_h - T_c}",
      "pages": [
        31
      ]
    },
    {
