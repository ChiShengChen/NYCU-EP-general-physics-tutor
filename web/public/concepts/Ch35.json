  "nodes": [
    {
      "id": "wave-optics",
      "label": "波動光學",
      "kind": "concept",
      "summary": "研究幾何光學無法解釋的現象，如干涉、繞射、偏振。",
      "latex": "",
      "pages": [
        1
      ]
    },
    {
      "id": "geometric-optics",
      "label": "幾何光學",
      "kind": "concept",
      "summary": "用光線模型解釋光傳播的學科，不考慮波動性。",
      "latex": "",
      "pages": [
        1
      ]
    },
    {
      "id": "interference-general",
      "label": "干涉",
      "kind": "concept",
      "summary": "兩束或多束波疊加，形成振幅增強或減弱的現象。",
      "latex": "",
      "pages": [
        1,
        3
      ]
    },
    {
      "id": "diffraction",
      "label": "繞射",
      "kind": "concept",
      "summary": "波遇到障礙物或孔隙時，偏離直線傳播方向並散開的現象。",
      "latex": "",
      "pages": [
        1
      ]
    },
    {
      "id": "polarization",
      "label": "偏振",
      "kind": "concept",
      "summary": "電磁波電場振動方向的特定取向。",
      "latex": "",
      "pages": [
        1
      ]
    },
    {
      "id": "constructive-interference",
      "label": "建設性干涉",
      "kind": "definition",
      "summary": "兩波疊加後，合成波振幅大於任一單獨波的現象。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "destructive-interference",
      "label": "破壞性干涉",
      "kind": "definition",
      "summary": "兩波疊加後，合成波振幅小於任一單獨波的現象。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "coherent-light-sources",
      "label": "同調光源",
      "kind": "concept",
      "summary": "能維持恆定相位差的光源。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "constant-phase-difference",
      "label": "恆定相位差",
      "kind": "concept",
      "summary": "兩波之間相位差保持不變的條件，是同調的必要條件。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "monochromatic-light",
      "label": "單色光",
      "kind": "concept",
      "summary": "單一頻率或波長的光，是同調的必要條件。",
      "latex": "",
      "pages": [
        3,
        5
      ]
    },
    {
      "id": "same-polarization",
      "label": "相同偏振",
      "kind": "concept",
      "summary": "電磁波產生穩定干涉所需的相同偏振方向。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "young-double-slit-experiment",
      "label": "楊氏雙狹縫實驗",
      "kind": "method",
      "summary": "利用雙狹縫產生兩束同調光，觀察干涉條紋的經典實驗。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "constructive-interference-phase-condition",
      "label": "建設性干涉相位條件",
      "kind": "formula",
      "summary": "兩波相位差為 $m(2\\pi)$ 時發生建設性干涉。",
      "latex": "$\\Delta\\Phi = m(2\\pi)$",
      "pages": [
        5
      ]
    },
    {
      "id": "destructive-interference-phase-condition",
      "label": "破壞性干涉相位條件",
      "kind": "formula",
      "summary": "兩波相位差為 $(2m+1)\\pi$ 時發生破壞性干涉。",
      "latex": "$\\Delta\\Phi = (2m+1)\\pi$",
      "pages": [
        5
      ]
    },
    {
      "id": "path-difference",
      "label": "光程差",
      "kind": "concept",
      "summary": "兩束光從光源到觀察點所行經路徑長度的差異。",
      "latex": "",
      "pages": [
        6
      ]
    },
    {
      "id": "constructive-interference-path-condition",
      "label": "建設性干涉光程條件",
      "kind": "formula",
      "summary": "光程差為 $m\\lambda$ 時發生建設性干涉。",
      "latex": "$\\delta = d \\sin \\theta = m\\lambda$",
      "pages": [
        6
      ]
    },
    {
      "id": "destructive-interference-path-condition",
      "label": "破壞性干涉光程條件",
      "kind": "formula",
      "summary": "光程差為 $(m+1/2)\\lambda$ 時發生破壞性干涉。",
      "latex": "$\\delta = d \\sin \\theta = (m+1/2)\\lambda$",
      "pages": [
        6
      ]
    },
    {
      "id": "small-angle-approximation",
      "label": "小角度近似",
      "kind": "principle",
      "summary": "當角度很小時，$\\sin\\theta \\approx \\tan\\theta \\approx \\theta$ 的近似方法。",
      "latex": "",
      "pages": [
        6
      ]
    },
    {
      "id": "bright-fringe-position",
      "label": "亮紋位置公式",
      "kind": "formula",
      "summary": "楊氏雙狹縫實驗中，亮紋在螢幕上的位置。",
      "latex": "$y_{\\text{bright}} = \\frac{\\lambda L}{d} m$",
      "pages": [
        6
      ]
    },
    {
      "id": "dark-fringe-position",
      "label": "暗紋位置公式",
      "kind": "formula",
      "summary": "楊氏雙狹縫實驗中，暗紋在螢幕上的位置。",
      "latex": "$y_{\\text{dark}} = \\frac{\\lambda L}{d} (m + \\frac{1}{2})$",
      "pages": [
        6
      ]
    },
    {
      "id": "superposition-principle",
      "label": "疊加原理",
      "kind": "principle",
      "summary": "多個波在同一介質中傳播時，合成波的位移是各個單獨波位移的向量和。",
      "latex": "",
      "pages": [
        9
      ]
    },
    {
      "id": "intensity-distribution-formula",
      "label": "雙狹縫干涉強度分佈",
      "kind": "formula",
      "summary": "描述雙狹縫干涉圖案中光強度隨位置變化的公式。",
      "latex": "$I = I_{\\max} \\cos^2 \\left(\\frac{\\pi d \\sin \\theta}{\\lambda}\\right)$",
      "pages": [
        9
      ]
    },
    {
      "id": "phasor-addition-of-waves",
      "label": "波的相量加法",
      "kind": "method",
      "summary": "用旋轉向量（相量）來表示和疊加簡諧波的方法。",
      "latex": "",
      "pages": [
        10
      ]
    },
    {
      "id": "phase-change-reflection-higher-n",
      "label": "反射相位變化 (高折射率)",
      "kind": "principle",
      "summary": "光從低折射率介質射向高折射率介質反射時，會產生 $180^\\circ$ 相位變化。",
      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "no-phase-change-reflection-lower-n",
      "label": "反射無相位變化 (低折射率)",
      "kind": "principle",
      "summary": "光從高折射率介質射向低折射率介質反射時，不會產生相位變化。",
      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "reflection-coefficient-electric-field",
      "label": "電場反射係數",
      "kind": "formula",
      "summary": "描述電磁波在介質界面反射時電場振幅變化的係數。",
      "latex": "$E_{\\text{reflection}} = \\left(\\frac{n_a - n_b}{n_a + n_b}\\right) E_{\\text{incidence}}$",
      "pages": [
        12
      ]
    },
    {
      "id": "lloyds-mirror",
      "label": "勞埃鏡",
      "kind": "method",
      "summary": "利用直接光和經鏡面反射光產生干涉條紋的實驗裝置。",
