{
  "nodes": [
    {
      "id": "induction-experiments-observation",
      "label": "感應實驗觀察",
      "kind": "concept",
      "summary": "感應電流產生於通過線圈的磁場變化。",
      "latex": "",
      "pages": [
        2
      ]
    },
    {
      "id": "magnetic-flux-definition",
      "label": "磁通量定義",
      "kind": "definition",
      "summary": "磁通量是通過某面積的磁場量，表示為磁場與面積向量的點積。",
      "latex": "d\\Phi_B = \\vec{B} \\cdot d\\vec{A} = B_\\perp dA = B dA \\cos \\phi",
      "pages": [
        4
      ]
    },
    {
      "id": "faradays-law-of-induction",
      "label": "法拉第感應定律",
      "kind": "law",
      "summary": "感應電動勢與通過電路磁通量的時間變化率成正比。",
      "latex": "\\mathcal{E} = (-) \\frac{d\\Phi_B}{dt}",
      "pages": [
        4
      ]
    },
    {
      "id": "faradays-law-integral-form",
      "label": "法拉第定律積分形式",
      "kind": "formula",
      "summary": "感應電場沿閉合路徑的環路積分等於磁通量的時間變化率。",
      "latex": "\\oint \\vec{E}_{ind.} \\cdot d\\vec{l} = (-) \\frac{d(\\int \\vec{B} \\cdot d\\vec{a})}{dt}",
      "pages": [
        4
      ]
    },
    {
      "id": "electric-potential-definition",
      "label": "電位定義",
      "kind": "definition",
      "summary": "電位是靜電場中單位電荷的位能，其環路積分為零。",
      "latex": "\\Delta V = -\\int_a^b \\vec{E}_q \\cdot d\\vec{l}",
      "pages": [
        5
      ]
    },
    {
      "id": "electromotive-force-definition",
      "label": "電動勢定義",
      "kind": "definition",
      "summary": "電動勢是單位電荷所受非靜電力沿閉合路徑做的功。",
      "latex": "\\mathcal{E} = \\oint \\vec{F} \\cdot d\\vec{l} = \\oint \\vec{E}_x \\cdot d\\vec{l}",
      "pages": [
        5
      ]
    },
    {
      "id": "right-hand-rule-dl-da",
      "label": "右手定則 (dl, da)",
      "kind": "method",
      "summary": "用於判斷環路積分方向與其所圍面積向量方向之間的關係。",
      "latex": "",
      "pages": [
        5
      ]
    },
    {
      "id": "faradays-law-n-loops",
      "label": "N匝線圈法拉第定律",
      "kind": "formula",
      "summary": "對於N匝線圈，總感應電動勢是單匝線圈磁通量變化率的N倍。",
      "latex": "\\mathcal{E} = -N \\frac{d\\Phi_B}{dt}",
      "pages": [
        6
      ]
    },
    {
      "id": "induced-e-solenoid-outside",
      "label": "螺線管外感應電場",
      "kind": "formula",
      "summary": "由螺線管內時變電流產生的螺線管外部感應電場強度。",
      "latex": "E = \\frac{\\mu_0 n R^2 \\omega I_{\\text{max}}}{2r} \\sin \\omega t \\quad (r > R)",
      "pages": [
        7
      ]
    },
    {
      "id": "induced-e-solenoid-inside",
      "label": "螺線管內感應電場",
      "kind": "formula",
      "summary": "由螺線管內時變電流產生的螺線管內部感應電場強度。",
      "latex": "E = \\frac{\\mu_0 n r \\omega I_{\\text{max}}}{2} \\sin \\omega t \\quad (r < R)",
      "pages": [
        8
      ]
    },
    {
      "id": "lenzs-law",
      "label": "冷次定律",
      "kind": "law",
      "summary": "感應電流的方向總是抵抗引起該電流的磁通量變化。",
      "latex": "",
      "pages": [
        9
      ]
    },
    {
      "id": "motional-emf-concept",
      "label": "動生電動勢",
      "kind": "concept",
      "summary": "導體在恆定磁場中運動時，由於電荷受磁力作用而產生的電動勢。",
      "latex": "",
      "pages": [
        10
