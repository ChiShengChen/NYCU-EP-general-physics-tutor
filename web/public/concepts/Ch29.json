    {
      "id": "motional-emf-integral-form",
      "label": "動生電動勢積分形式",
      "kind": "formula",
      "summary": "動生電動勢是動生電場沿閉合路徑的環路積分。",
      "latex": "\\mathcal{E}_{\\text{Motion}} = \\oint (\\vec{v} \\times \\vec{B}) \\cdot d\\vec{l}",
      "pages": [
        11
