{
  "nodes": [
    {
      "id": "maxwells-equations",
      "label": "馬克士威方程式",
      "kind": "law",
      "summary": "描述電場與磁場如何產生、變化，並預測電磁波存在的四個基本方程式。",
      "latex": "\\oint \\vec{E} \\cdot d\\vec{a} = \\frac{q}{\\varepsilon_0} \\\\ \\oint \\vec{B} \\cdot d\\vec{a} = 0 \\\\ \\oint \\vec{E} \\cdot d\\vec{\\ell} = -\\frac{d\\Phi_B}{dt} \\\\ \\oint \\vec{B} \\cdot d\\vec{\\ell} = \\mu_0 I + \\mu_0 \\varepsilon_0 \\frac{d\\Phi_E}{dt}",
      "pages": [
        2
      ]
    },
    {
      "id": "lorentz-force",
      "label": "勞侖茲力",
      "kind": "formula",
      "summary": "描述帶電粒子在電磁場中所受的力。",
      "latex": "\\vec{F} = q(\\vec{E} + \\vec{v} \\times \\vec{B})",
      "pages": [
        2
      ]
    },
    {
      "id": "em-wave-equation-vacuum",
      "label": "真空電磁波方程式",
      "kind": "formula",
      "summary": "從馬克士威方程式推導出的電場和磁場在真空中傳播的波動方程式。",
      "latex": "\\frac{\\partial^2 E}{\\partial x^2} = \\mu_o \\varepsilon_o \\frac{\\partial^2 E}{\\partial t^2} \\\\ \\frac{\\partial^2 B}{\\partial x^2} = \\mu_o \\varepsilon_o \\frac{\\partial^2 B}{\\partial t^2}",
      "pages": [
        3,
        6
      ]
    },
