    {
      "id": "galilean-relativity-principle",
      "label": "伽利略相對性原理",
      "kind": "principle",
      "summary": "力學定律在所有慣性參考系中都具有相同的形式，不存在絕對的靜止參考系。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "galilean-transformation",
      "label": "伽利略轉換",
      "kind": "formula",
      "summary": "描述不同慣性參考系之間時空座標轉換的古典方程式。",
      "latex": "x' = x - vt, y' = y, z' = z, t' = t",
      "pages": [
        4,
        36
      ]
    },
    {
      "id": "galilean-velocity-transformation",
      "label": "伽利略速度轉換",
      "kind": "formula",
      "summary": "描述不同慣性參考系之間速度如何疊加的古典方程式。",
      "latex": "u'_x = u_x - v",
      "pages": [
        4
      ]
    },
    {
      "id": "michelson-morley-experiment",
      "label": "邁克生-莫雷實驗",
      "kind": "concept",
      "summary": "一項旨在測量地球相對於「以太」運動的實驗，其零結果否定了以太的存在，並啟發了相對論。",
      "latex": "",
      "pages": [
        5,
        6
      ]
    },
    {
      "id": "relativity-postulate",
      "label": "相對性原理",
      "kind": "principle",
      "summary": "所有物理定律（不只力學）在所有慣性參考系中都具有相同的形式。",
      "latex": "",
      "pages": [
        8
      ]
    },
    {
      "id": "light-speed-constancy-postulate",
      "label": "光速不變原理",
      "kind": "principle",
      "summary": "真空中的光速在所有慣性參考系中對所有觀測者都是相同的，與光源或觀測者的運動無關。",
      "latex": "",
      "pages": [
        9
      ]
    },
    {
      "id": "relativity-of-simultaneity",
      "label": "同時的相對性",
      "kind": "concept",
      "summary": "在一個參考系中同時發生的兩個事件，在相對於該參考系運動的另一個參考系中，通常並不同時。",
      "latex": "",
      "pages": [
        13,
        14,
        15,
        16
      ]
    },
    {
      "id": "proper-time",
      "label": "固有時間",
      "kind": "definition",
      "summary": "在一個慣性參考系中，於同一地點發生之兩個事件間的時間間隔。",
      "latex": "",
      "pages": [
        18,
        20
      ]
    },
    {
      "id": "time-dilation",
      "label": "時間膨脹",
      "kind": "concept",
      "summary": "運動中的時鐘相對於靜止觀測者的時鐘走得更慢的現象。",
      "latex": "",
      "pages": [
        19,
        20
      ]
    },
    {
      "id": "lorentz-factor",
      "label": "勞倫茲因子",
      "kind": "definition",
      "summary": "相對論中常用的一個因子 γ，定義為 1 除以根號 1 減 v²/c²，量化了相對論效應的強度。",
      "latex": "\\gamma = \\frac{1}{\\sqrt{1-v^2/c^2}}",
      "pages": [
        20
      ]
    },
    {
      "id": "time-dilation-formula",
      "label": "時間膨脹公式",
      "kind": "formula",
      "summary": "運動參考系測量的時間間隔 Δt 與固有時間 Δt₀ 之間的關係式。",
      "latex": "\\Delta t = \\gamma \\Delta t_0",
      "pages": [
        20
      ]
    },
    {
      "id": "twin-paradox",
      "label": "雙生子悖論",
      "kind": "concept",
      "summary": "一個關於時間膨脹的思想實驗，其中進行高速太空旅行的雙胞胎回來後比留在地球上的雙胞胎更年輕。",
      "latex": "",
      "pages": [
        24
      ]
    },
    {
      "id": "proper-length",
      "label": "固有長度",
      "kind": "definition",
      "summary": "在物體靜止的參考系中所測量的物體長度。",
      "latex": "",
      "pages": [
        26
      ]
    },
    {
      "id": "length-contraction",
      "label": "長度收縮",
      "kind": "concept",
      "summary": "運動中的物體在其運動方向上的長度，會比其固有長度縮短的現象。",
      "latex": "",
      "pages": [
        27
      ]
    },
    {
      "id": "length-contraction-formula",
      "label": "長度收縮公式",
      "kind": "formula",
      "summary": "運動物體測量長度 L 與其固有長度 L₀ 之間的關係式。",
      "latex": "L = L_0 / \\gamma",
      "pages": [
        27,
        39
      ]
    },
    {
      "id": "barn-pole-paradox",
      "label": "穀倉桿子悖論",
      "kind": "concept",
      "summary": "一個關於長度收縮與同時相對性的思想實驗，探討一個長桿子是否能完全容納在一個較短的穀倉中。",
      "latex": "",
      "pages": [
        28,
        29
      ]
    },
    {
      "id": "lorentz-transformation",
      "label": "勞倫茲轉換",
      "kind": "formula",
      "summary": "聯繫兩個作相對勻速運動的慣性參考系之間時空座標的轉換關係式。",
      "latex": "x' = \\gamma(x - vt), t' = \\gamma(t - vx/c^2)",
      "pages": [
        36,
        37
      ]
    },
    {
      "id": "causality-principle",
      "label": "因果律",
      "kind": "principle",
      "summary": "任何效應的發生時間不能早於其原因的發生時間，這要求資訊傳遞速度不能超過光速。",
      "latex": "",
      "pages": [
        41,
        42
      ]
    },
    {
      "id": "relativistic-velocity-transformation",
      "label": "相對論速度轉換",
      "kind": "formula",
      "summary": "在不同慣性參考系之間轉換速度的相對論公式，取代了伽利略速度轉換。",
      "latex": "u = \\frac{u' + v}{1 + u'v/c^2}",
      "pages": [
        45
      ]
    },
    {
      "id": "relativistic-momentum",
      "label": "相對論動量",
      "kind": "definition",
