{
  "nodes": [
    {
      "id": "net-force-definition",
      "label": "合力定義",
      "kind": "definition",
      "summary": "作用於物體的所有力的向量和，決定物體的加速度。",
      "latex": "",
      "pages": [
        2
      ]
    },
    {
      "id": "equilibrium-definition",
      "label": "平衡定義",
      "kind": "definition",
      "summary": "當物體所受合力為零時，其速度保持不變的狀態。",
      "latex": "",
      "pages": [
        2
      ]
    },
    {
      "id": "force-is-vector",
      "label": "力是向量",
      "kind": "concept",
      "summary": "力具有大小和方向，因此是向量，遵循向量加法法則。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "contact-force",
      "label": "接觸力",
      "kind": "concept",
      "summary": "物體直接接觸時產生的力，如推力、拉力、摩擦力。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "field-force",
      "label": "場力",
      "kind": "concept",
      "summary": "物體不需直接接觸即可作用的力，如重力、電力、磁力。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "normal-force-definition",
      "label": "法線力定義",
      "kind": "definition",
      "summary": "表面對其上物體施加的垂直於表面的推力。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "friction-force-definition",
      "label": "摩擦力定義",
      "kind": "definition",
      "summary": "表面對其上物體施加的平行於表面的阻礙運動的力。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "tension-force-definition",
      "label": "張力定義",
      "kind": "definition",
      "summary": "繩索、繩索等對物體施加的拉力。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "weight-definition",
      "label": "重量定義",
      "kind": "definition",
      "summary": "地球對物體施加的重力，方向指向地心。",
      "latex": "",
      "pages": [
        4,
        12
      ]
    },
    {
      "id": "newtons-first-law",
      "label": "牛頓第一定律",
      "kind": "law",
      "summary": "若物體不受外力作用，則靜者恆靜，動者恆作等速直線運動。",
      "latex": "",
      "pages": [
        5
      ]
    },
    {
      "id": "inertial-frame-definition",
      "label": "慣性參考系",
      "kind": "definition",
      "summary": "在此參考系中，不受外力作用的物體具有零加速度，牛頓定律在此成立。",
      "latex": "",
      "pages": [
        5
      ]
    },
    {
      "id": "inertia-concept",
      "label": "慣性概念",
      "kind": "concept",
      "summary": "物體抵抗其運動狀態改變的傾向。",
      "latex": "",
      "pages": [
        10
      ]
    },
    {
      "id": "fictitious-force",
      "label": "虛擬力",
      "kind": "concept",
      "summary": "在非慣性參考系中觀察到的、為解釋運動而引入的假想力。",
      "latex": "",
      "pages": [
        5,
        6
      ]
    },
    {
      "id": "machs-principle",
      "label": "馬赫原理",
      "kind": "principle",
      "summary": "任何運動的意義都只相對於其他物體而言，不存在絕對運動。",
      "latex": "",
      "pages": [
        7,
        9
      ]
    },
    {
      "id": "mass-definition",
      "label": "質量定義",
      "kind": "definition",
      "summary": "物體抵抗其速度改變的程度，是慣性的量度。",
      "latex": "",
      "pages": [
        10
      ]
    },
    {
      "id": "newtons-second-law",
      "label": "牛頓第二定律",
      "kind": "law",
      "summary": "物體的加速度與所受合力成正比，與其質量成反比。",
      "latex": "\\Sigma F = ma",
      "pages": [
        11
      ]
    },
    {
      "id": "newton-unit",
      "label": "牛頓單位",
      "kind": "definition",
      "summary": "力的國際單位，定義為使一公斤物體產生一公尺每秒平方加速度所需的力。",
      "latex": "",
      "pages": [
        11
      ]
    },
    {
      "id": "internal-force",
      "label": "內力",
      "kind": "concept",
      "summary": "系統內部各部分之間相互作用的力，不影響系統整體的加速度。",
      "latex": "",
      "pages": [
        11
      ]
    },
    {
      "id": "gravitational-force-concept",
      "label": "重力概念",
      "kind": "concept",
      "summary": "地球對物體施加的吸引力，方向指向地心。",
      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "weight-formula",
      "label": "重量公式",
      "kind": "formula",
      "summary": "物體所受重力的大小，等於其質量乘以重力加速度。",
      "latex": "W = mg",
      "pages": [
        12
      ]
    },
    {
      "id": "weight-vs-mass",
      "label": "重量與質量",
      "kind": "concept",
      "summary": "質量是物體慣性的量度，而重量是物體所受的重力，兩者概念不同。",
      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "gravitational-mass",
      "label": "重力質量",
      "kind": "definition",
      "summary": "決定物體之間萬有引力大小的質量。",
      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "inertial-mass",
      "label": "慣性質量",
      "kind": "definition",
      "summary": "衡量物體抵抗加速度變化的能力，即慣性的量度。",
      "latex": "",
      "pages": [
        12
      ]
    },
    {
      "id": "equivalence-principle",
      "label": "等效原理",
      "kind": "principle",
      "summary": "慣性質量與重力質量相等，是廣義相對論的基礎。",
      "latex": "",
      "pages": [
        12,
        13
      ]
    },
    {
      "id": "newtons-third-law",
      "label": "牛頓第三定律",
      "kind": "law",
      "summary": "作用力與反作用力大小相等、方向相反，且作用在不同物體上。",
      "latex": "F_{12} = -F_{21}",
      "pages": [
        14
      ]
    },
    {
      "id": "free-body-diagram-method",
      "label": "自由體圖法",
      "kind": "method",
      "summary": "將物體從其環境中分離出來，並繪製所有作用於該物體上的力的圖示。",
      "latex": "",
      "pages": [
        16
      ]
    }
