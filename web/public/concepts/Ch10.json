{
  "nodes": [
    {
      "id": "torque-definition",
      "label": "力矩定義",
      "kind": "definition",
      "summary": "力矩是使物體繞某軸轉動的趨勢，定義為位置向量與力的外積。",
      "latex": "\\vec{\\tau} = \\vec{r} \\times \\vec{F}",
      "pages": [
        2,
        3,
        14
      ]
    },
    {
      "id": "torque-magnitude",
      "label": "力矩大小",
      "kind": "formula",
      "summary": "力矩的大小等於力臂與力的乘積，或力、位置向量與兩者夾角正弦值的乘積。",
      "latex": "\\tau = r (F \\sin \\phi) = F d",
      "pages": [
        3
      ]
    },
    {
      "id": "moment-arm",
      "label": "力臂",
      "kind": "concept",
      "summary": "力臂是從支點到力作用線的垂直距離。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "net-torque",
      "label": "淨力矩",
      "kind": "concept",
      "summary": "作用在物體上的所有力矩的向量和。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "internal-torques-cancel",
      "label": "內力矩抵消原理",
      "kind": "principle",
      "summary": "系統內部的力矩總和為零，不影響系統的總角動量。",
      "latex": "\\sum_i \\vec{\\tau}_{i, \\text{int}} = 0",
      "pages": [
        4,
        65
      ]
    },
    {
      "id": "moment-of-inertia-definition",
      "label": "轉動慣量定義",
      "kind": "definition",
      "summary": "轉動慣量是物體抵抗角加速度的量度，對於點質量為mr²，對於連續物體為∫r²dm。",
      "latex": "I = \\sum_i m_i r_i^2 \\quad \\text{or} \\quad I = \\int r^2 dm",
      "pages": [
        4,
        5,
        64
      ]
    },
    {
      "id": "torque-angular-acceleration-relation",
      "label": "力矩與角加速度關係",
      "kind": "formula",
      "summary": "淨力矩等於轉動慣量與角加速度的乘積，是轉動的牛頓第二定律。",
      "latex": "\\vec{\\tau} = I\\vec{\\alpha}",
      "pages": [
        4,
        5,
        40,
        42,
        62
      ]
    },
    {
      "id": "total-torque-vs-cm-torque",
      "label": "總力矩與質心力矩",
      "kind": "concept",
      "summary": "一般而言，作用在系統上的總力矩不等於作用在質心上的力矩。",
      "latex": "",
      "pages": [
        8,
        9,
        14,
        65
      ]
    },
    {
      "id": "torque-due-to-gravity",
      "label": "重力力矩",
      "kind": "formula",
      "summary": "在均勻重力場中，重力對物體產生的總力矩等同於總重力作用在質心上所產生的力矩。",
      "latex": "\\vec{\\tau}_{total,g} = \\vec{r}_{CM} \\times M\\vec{g}",
      "pages": [
        9
      ]
    },
    {
      "id": "torque-arbitrary-pivot-vs-cm",
      "label": "任意支點與質心力矩關係",
      "kind": "formula",
      "summary": "關於任意支點O的總力矩等於關於質心的力矩加上質心位置向量與總外力的外積。",
      "latex": "\\vec{\\tau}_o = \\vec{\\tau}_{o \\text{ at CM}} + \\vec{r}_{CM} \\times \\vec{F}_{CM}",
      "pages": [
        13,
        14,
        49,
        65
      ]
    },
    {
      "id": "torque-angular-acceleration-validity",
      "label": "力矩角加速度關係適用性",
      "kind": "principle",
      "summary": "公式τ=Iα僅在力垂直於轉軸或物體繞對稱軸轉動時有效。",
      "latex": "",
      "pages": [
        14,
        41,
        65
      ]
    },
    {
      "id": "work-rotational",
      "label": "轉動功",
      "kind": "formula",
      "summary": "力矩在角位移上所做的功，等於力矩對角位移的積分。",
      "latex": "W = \\int \\tau d\\theta",
      "pages": [
        15,
        42,
        62,
        65
      ]
    },
    {
      "id": "power-rotational",
      "label": "轉動功率",
      "kind": "formula",
      "summary": "轉動功率是力矩與角速度的乘積。",
      "latex": "P = \\tau\\omega",
      "pages": [
        15,
        42,
        65
      ]
    },
    {
      "id": "rotational-kinetic-energy",
      "label": "轉動動能",
      "kind": "formula",
      "summary": "物體因轉動而擁有的動能，等於二分之一轉動慣量與角速度平方的乘積。",
      "latex": "K_R = \\frac{1}{2}I\\omega^2",
      "pages": [
        16,
        42,
        61,
        66
      ]
    },
    {
      "id": "work-kinetic-energy-theorem-rotational",
      "label": "轉動功動能定理",
      "kind": "law",
      "summary": "作用在物體上的淨轉動功等於其轉動動能的變化量。",
      "latex": "W_R = \\Delta K_R",
      "pages": [
        16,
        18,
        66
      ]
    },
    {
      "id": "rolling-motion-definition",
      "label": "滾動運動定義",
      "kind": "definition",
      "summary": "滾動運動是物體同時進行平移和轉動的複合運動。",
      "latex": "",
      "pages": [
        21
      ]
    },
    {
      "id": "no-slipping-condition",
      "label": "無滑動條件",
      "kind": "definition",
      "summary": "物體滾動時，接觸點與地面之間沒有相對滑動，質心速度等於半徑乘以角速度，質心加速度等於半徑乘以角加速度。",
      "latex": "v_{CM} = R\\omega, \\quad a_{CM} = R\\alpha",
      "pages": [
        23,
        25,
        31
      ]
    },
    {
      "id": "rolling-motion-decomposition",
      "label": "滾動運動分解",
      "kind": "concept",
      "summary": "滾動運動可分解為質心的純平移運動和繞質心的純轉動運動。",
      "latex": "",
      "pages": [
        24
      ]
    },
    {
      "id": "total-kinetic-energy-rolling",
      "label": "滾動總動能",
      "kind": "formula",
      "summary": "滾動物體的總動能是質心平移動能與繞質心轉動動能的總和。",
      "latex": "K_{\\text{total}} = \\frac{1}{2}Mv_{\\text{CM}}^2 + \\frac{1}{2}I_{\\text{CM}}\\omega^2",
      "pages": [
        25,
        28
      ]
    },
    {
      "id": "rolling-motion-pure-rotation-pivot-contact",
      "label": "接觸點純轉動觀點",
      "kind": "concept",
      "summary": "滾動運動可視為物體繞其與地面接觸點的瞬時軸進行純轉動。",
      "latex": "",
      "pages": [
        28
      ]
    },
    {
      "id": "parallel-axis-theorem",
      "label": "平行軸定理",
      "kind": "law",
      "summary": "物體繞任意軸的轉動慣量等於繞平行於該軸並通過質心的軸的轉動慣量加上物體質量與兩軸間距離平方的乘積。",
      "latex": "I_P = I_{CM} + MD^2",
      "pages": [
        28,
        35,
        64
