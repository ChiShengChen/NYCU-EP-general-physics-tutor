{
  "nodes": [
    {
      "id": "newtons-law-universal-gravitation",
      "label": "牛頓萬有引力定律",
      "kind": "law",
      "summary": "兩個物體間的引力與其質量乘積成正比，與其距離平方成反比。",
      "latex": "F_g = G \\frac{m_1 m_2}{r^2}",
      "pages": [
        3
      ]
    },
    {
      "id": "gravitational-constant",
      "label": "萬有引力常數",
      "kind": "concept",
      "summary": "萬有引力定律中的比例常數，其值為 $6.673 \\times 10^{-11} \\text{N} \\cdot \\text{m}^2/\\text{kg}^2$。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "inverse-square-law-gravity",
      "label": "平方反比定律",
      "kind": "concept",
      "summary": "萬有引力的大小與物體間距離的平方成反比。",
      "latex": "",
      "pages": [
        3
      ]
    },
    {
      "id": "spherically-symmetric-mass-gravitation",
      "label": "球對稱質量引力",
      "kind": "principle",
      "summary": "球對稱質量分佈對外部粒子的引力，等同於所有質量集中在其中心。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "centripetal-acceleration-formula",
      "label": "向心加速度公式",
      "kind": "formula",
      "summary": "物體作圓周運動時，向心加速度的大小與速度平方成正比，與半徑成反比。",
      "latex": "a_M = \\frac{v^2}{r_M} = \\frac{(2\\pi r_M / T)^2}{r_M} = \\frac{4\\pi^2 r_M}{T^2}",
      "pages": [
        4
      ]
    },
    {
      "id": "newtons-law-experimental-proof",
      "label": "牛頓定律實驗驗證",
      "kind": "method",
      "summary": "透過比較月球繞地球的加速度與地球表面重力加速度，驗證萬有引力定律的平方反比關係。",
      "latex": "",
      "pages": [
        4
      ]
    },
    {
      "id": "cavendish-apparatus",
      "label": "卡文迪許實驗",
      "kind": "method",
      "summary": "用於測量萬有引力常數 G 的實驗裝置。",
      "latex": "",
      "pages": [
        5
      ]
    },
    {
      "id": "free-fall-acceleration-formula",
      "label": "自由落體加速度",
      "kind": "formula",
      "summary": "物體在地球表面或其上方高度 h 處的重力加速度。",
      "latex": "g = \\frac{GM_E}{(R_E + h)^2}",
      "pages": [
        5
      ]
    },
    {
      "id": "gravitational-field-definition",
      "label": "重力場定義",
      "kind": "definition",
      "summary": "單位質量所受的重力，描述空間中重力作用的強度與方向。",
      "latex": "",
      "pages": [
        6
      ]
    },
    {
      "id": "gravitational-field-point-mass",
      "label": "點質量重力場",
      "kind": "formula",
      "summary": "由點質量 M 產生的重力場，方向指向質量 M。",
      "latex": "\\vec{g} = -\\frac{GM}{r^2}\\hat{r}",
      "pages": [
        6
      ]
    },
    {
      "id": "gravitational-field-spherical-shell",
      "label": "球殼內重力場",
      "kind": "law",
      "summary": "均勻球殼對其內部任何一點的重力場為零。",
      "latex": "\\vec{g} = \\begin{cases} -\\frac{GM}{r^2}\\hat{r}, & r > R \\\\ \\vec{0}, & r < R \\end{cases}",
      "pages": [
        7
      ]
    },
    {
      "id": "solid-angle",
      "label": "立體角",
      "kind": "concept",
      "summary": "描述物體在空間中張開的角度大小，單位為球面度。",
      "latex": "",
      "pages": [
        8
      ]
    },
    {
      "id": "gravitational-field-solid-sphere",
      "label": "實心球內重力場",
      "kind": "law",
      "summary": "均勻實心球對其內部一點的重力場與該點到球心的距離成正比。",
      "latex": "\\vec{g}(r) = - \\frac{GM}{R^3} r \\hat{r}, \\text{ for } r < R.",
      "pages": [
        9
      ]
    },
    {
      "id": "conservative-force",
      "label": "守恆力",
      "kind": "concept",
      "summary": "做功與路徑無關，只取決於始末位置的力。",
      "latex": "",
      "pages": [
        10
      ]
    },
    {
      "id": "gravitational-potential-energy-definition",
      "label": "重力位能定義",
      "kind": "definition",
      "summary": "兩個質量之間由於重力作用而儲存的能量，通常以無窮遠處為零位面。",
      "latex": "",
      "pages": [
        10
      ]
    },
    {
      "id": "gravitational-potential-energy-multiple-particles",
      "label": "多粒子重力位能",
      "kind": "formula",
      "summary": "多個粒子系統的總重力位能是每對粒子間位能的總和。",
      "latex": "U_{total} = -G\\left(\\frac{m_1m_2}{r_{12}} + \\frac{m_1m_3}{r_{13}} + \\frac{m_2m_3}{r_{23}}\\right)",
      "pages": [
        11
      ]
    },
    {
      "id": "gravitational-potential-energy-near-surface",
      "label": "近地表重力位能",
      "kind": "formula",
      "summary": "在地球表面附近，重力位能的變化量近似為 $mg\\Delta y$。",
      "latex": "\\Delta U = mg\\Delta y",
      "pages": [
        11
      ]
    },
    {
      "id": "total-energy-planetary-motion",
      "label": "行星運動總能",
      "kind": "formula",
      "summary": "行星運動的總能量是動能與重力位能的總和。",
      "latex": "E = K + U = \\frac{1}{2}mv^2 - \\frac{GM_E m}{r}",
      "pages": [
        12
      ]
    },
    {
      "id": "total-energy-circular-orbit",
      "label": "圓軌道總能",
      "kind": "formula",
      "summary": "物體在圓形軌道上的總能量，為負值且與半徑成反比。",
      "latex": "E = -\\frac{GM_E m}{2r}",
      "pages": [
        12
      ]
    },
    {
      "id": "total-energy-elliptical-orbit",
      "label": "橢圓軌道總能",
      "kind": "formula",
      "summary": "物體在橢圓軌道上的總能量，為負值且與半長軸成反比。",
      "latex": "E = -\\frac{GM_E m}{2a}",
      "pages": [
        12,
        13
      ]
    },
    {
      "id": "bound-unbound-orbits",
      "label": "束縛與非束縛軌道",
      "kind": "concept",
      "summary": "總能量 E < 0 為束縛軌道（橢圓或圓），E >= 0 為非束縛軌道（拋物線或雙曲線）。",
      "latex": "",
      "pages": [
        13
      ]
    },
    {
      "id": "escape-speed-definition",
      "label": "脫離速度",
      "kind": "definition",
      "summary": "物體能完全脫離行星引力所需的最小初速度。",
      "latex": "",
      "pages": [
        14
      ]
    },
    {
      "id": "black-hole",
      "label": "黑洞",
      "kind": "concept",
      "summary": "引力極強以至於任何物質（包括光）都無法逃脫的天體。",
      "latex": "",
      "pages": [
        15
      ]
    },
    {
      "id": "schwarzschild-radius",
      "label": "史瓦西半徑",
      "kind": "definition",
      "summary": "黑洞的事件視界半徑，光速也無法逃脫的臨界半徑。",
      "latex": "",
      "pages": [
        15
      ]
    },
    {
      "id": "white-dwarf-star",
      "label": "白矮星",
      "kind": "concept",
      "summary": "恆星演化末期的一種緻密星體，質量小於 1.4 倍太陽質量。",
      "latex": "",
      "pages": [
        16
      ]
    },
    {
      "id": "neutron-star",
      "label": "中子星",
      "kind": "concept",
      "summary": "恆星演化末期的一種極緻密星體，質量介於 1.4 到 3 倍太陽質量之間。",
      "latex": "",
      "pages": [
        16
      ]
    },
    {
      "id": "accretion-disk",
      "label": "吸積盤",
      "kind": "concept",
      "summary": "物質在落入黑洞或其他緻密天體前，因角動量守恆而形成的旋轉盤狀結構。",
      "latex": "",
      "pages": [
        17
