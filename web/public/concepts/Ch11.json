    },
    {
      "id": "torque-transformation-formula",
      "label": "力矩轉換公式",
      "kind": "formula",
      "summary": "描述不同軸心O與O'之間力矩的關係。",
      "latex": "\\vec{\\tau}_o = \\vec{\\tau}_{o'} + \\vec{r}' \\times \\sum_i \\vec{F}_i",
      "pages": [
        5
      ]
    },
    {
