    {
      "id": "translational-equilibrium-condition",
      "label": "平移動平衡條件",
      "kind": "law",
      "summary": "物體所受合力為零，使其沒有整體移動的趨勢。",
      "latex": "\\sum \\vec{F} = 0",
      "pages": [
        2
      ]
    },
    {
      "id": "rotational-equilibrium-condition",
      "label": "轉動平衡條件",
      "kind": "law",
      "summary": "物體所受合力矩為零，使其沒有整體轉動的趨勢。",
      "latex": "\\sum \\vec{\\tau} = 0",
      "pages": [
        2
      ]
    },
    {
      "id": "static-equilibrium-definition",
      "label": "靜力平衡",
      "kind": "definition",
      "summary": "物體相對於慣性參考系靜止，且無平移與轉動。",
      "latex": "",
      "pages": [
        2
      ]
    },
    {
      "id": "net-force-formula",
      "label": "合力公式",
      "kind": "formula",
      "summary": "計算物體所受所有力的向量和。",
      "latex": "\\vec{F} = \\sum_i \\vec{F}_i",
      "pages": [
        3
      ]
    },
    {
      "id": "net-torque-formula",
      "label": "合力矩公式",
      "kind": "formula",
      "summary": "計算物體所受所有力矩的向量和。",
      "latex": "\\vec{\\tau} = \\sum_i \\vec{r}_i \\times \\vec{F}_i",
      "pages": [
        3
      ]
    },
    {
      "id": "force-torque-independence",
      "label": "力矩獨立性",
