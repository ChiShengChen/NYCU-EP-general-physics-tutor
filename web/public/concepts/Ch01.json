      "id": "vector-product-definition",
      "label": "向量外積定義",
      "kind": "formula",
      "summary": "兩個向量外積的大小定義，等於兩向量大小與夾角正弦的乘積。",
      "latex": "|\\vec{A} \\times \\vec{B}| = AB \\sin \\phi",
      "pages": [
        21
      ]
    },
