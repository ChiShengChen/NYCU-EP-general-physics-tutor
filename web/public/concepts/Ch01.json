{
  "nodes": [
    {
      "id": "physical-quantity",
      "label": "物理量",
      "kind": "concept",
      "summary": "任何可以被測量或計算的物理屬性。",
      "latex": "",
      "pages": [
        7
      ]
    },
    {
      "id": "fundamental-quantity",
      "label": "基本物理量",
      "kind": "concept",
      "summary": "獨立於其他物理量，無法透過其他物理量定義的量，如長度、質量、時間。",
      "latex": "",
      "pages": [
        7
      ]
    },
    {
