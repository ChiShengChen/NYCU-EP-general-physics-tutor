      "latex": "",
      "pages": [
        21
      ]
    },
    {
      "id": "resultant-vector-magnitude",
      "label": "合向量大小",
      "kind": "formula",
      "summary": "透過分量計算合向量大小的公式。",
      "latex": "R = \\sqrt{(A_x + B_x)^2 + (A_y + B_y)^2}",
      "pages": [
        21
      ]
    },
    {
      "id": "resultant-vector-angle",
      "label": "合向量角度",
      "kind": "formula",
      "summary": "透過分量計算合向量方向角度的公式。",
      "latex": "\\tan \\theta = \\frac{A_y + B_y}{A_x + B_x}",
      "pages": [
        21
      ]
    }
