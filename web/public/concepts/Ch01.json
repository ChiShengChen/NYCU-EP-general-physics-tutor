    {
      "id": "planck-constant",
      "label": "普朗克常數",
      "kind": "concept",
      "summary": "物理學中的基本常數，用於定義新版公斤。",
      "latex": "",
      "pages": [
        8
      ]
    },
    {
      "id": "kilogram-new-definition",
      "label": "新公斤定義",
      "kind": "definition",
      "summary": "2018年後，公斤的定義基於普朗克常數。",
      "latex": "",
      "pages": [
        8
      ]
    },
    {
      "id": "kilogram-planck-formula",
      "label": "公斤普朗克公式",
      "kind": "formula",
      "summary": "質量 $m$ 與普朗克常數 $h$、光速 $c$ 及銫原子頻率 $\\nu_{Cs}$ 的關係式。",
      "latex": "m = \\frac{h \\nu_{Cs}}{c^2}",
      "pages": [
        8
      ]
    },
    {
      "id": "kibble-balance",
      "label": "瓦特天平",
      "kind": "method",
      "summary": "一種高精度測量質量的方法，透過電磁力與重力平衡來定義公斤。",
      "latex": "",
      "pages": [
        9
      ]
    },
    {
      "id": "kibble-balance-weighting-mode",
      "label": "瓦特天平稱重模式",
      "kind": "concept",
      "summary": "瓦特天平透過平衡重力與勞倫茲力來測量質量。",
      "latex": "w = mg = BLI",
      "pages": [
        9
      ]
    },
    {
      "id": "kibble-balance-moving-mode",
      "label": "瓦特天平移動模式",
      "kind": "concept",
      "summary": "瓦特天平透過線圈在磁場中移動感應電壓來測量 $BLv$。",
      "latex": "\\Delta V = BLv",
      "pages": [
        9
      ]
    },
    {
      "id": "kibble-balance-combined-formula",
      "label": "瓦特天平組合公式",
      "kind": "formula",
      "summary": "結合稱重與移動模式，推導出質量與電流、電壓、速度的關係。",
      "latex": "m = \\frac{I\\Delta V}{gv}",
      "pages": [
        9
      ]
    },
